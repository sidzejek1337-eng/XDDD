      public function getClosestQM() : TeamQM
      {
         var closestTeam:TeamQM = null;
         var dist:Number = NaN;
         var myteam:TeamUser = Client.myTeam;
         var closestDist:Number = 1.7976931348623157e+308;
         for each(var team:Team in MapManager3D.getInstance().teams)
         {
            if(team is TeamQM)
            {
               dist = MathUtils.getDistance(team.x,team.y,myteam.x,myteam.y);
               if(dist < closestDist)
               {
                  closestDist = dist;
                  closestTeam = team as TeamQM;
               }
            }
         }
         return closestTeam;
      }
      
