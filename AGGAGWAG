      public function calculateReducedViewDistance(loopCount:int = 0) : void
      {
         var count:int = 0;
         if(loopCount > 30)
         {
            return;
         }
         if(countUserTeams() - 1 > MAX_TEAMS_USER_VISIBLE)
         {
            count = countPlayersInReducedRange();
            if(count > MAX_TEAMS_USER_VISIBLE)
            {
               if(count > 1.2 * MAX_TEAMS_USER_VISIBLE)
               {
                  _distanceVisibleReducedUsers -= 5;
               }
               else
               {
                  _distanceVisibleReducedUsers -= 1;
               }
               if(_distanceVisibleReducedUsers < MIN_DISTANCE_VISIBLE_USERS)
               {
                  _distanceVisibleReducedUsers = MIN_DISTANCE_VISIBLE_USERS;
               }
               else
               {
                  calculateReducedViewDistance(++loopCount);
               }
            }
         }
         else
         {
            _distanceVisibleReducedUsers = _distanceVisible;
         }
      }
      
      private function countUserTeams() : int
      {
         var count:int = 0;
         for each(var team:Team in _teams)
         {
            if(team.isUser())
            {
               count++;
            }
         }
         return count;
      }
      
      private function countNpcTeams() : int
      {
         var count:int = 0;
