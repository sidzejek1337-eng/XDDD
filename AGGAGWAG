            }
         }
         return count;
      }
      
      public function calculateReducedViewDistanceNPC(loopCount:int = 0) : void
      {
         var count:int = 0;
         if(loopCount > 30)
         {
            return;
         }
         if(countNpcTeams() > MAX_TEAMS_NPC_VISIBLE)
         {
            count = countNPCInReducedRange();
            if(count > MAX_TEAMS_NPC_VISIBLE)
