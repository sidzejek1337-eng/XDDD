      public function onMyTeamMovement(msg:String, x3d:int, y3d:int, nextX3d:int, nextY3d:int, walkType:uint = 4) : void
      {
         var data:String = null;
         var t:Team = null;
         var i:int = 0;
         var j:int = 0;
         var k:int = 0;
         var l:int = 0;
         var tab:Array = msg.split("$");
         var tabXY:Array = tab[0].split(",");
         var x:Number = Number(tabXY[0]);
         var y:Number = Number(tabXY[1]);
         _movementManager.updateServerPosition(x,y);
         if(Client.id != Client.myTeam.leaderId)
         {
            _movementManager.updateLocalPosition(x,y);
            if(Client.myTeam.lookOverride != null)
            {
               Client.myTeam.modelGoTo(x3d,y3d,true,nextX3d,nextY3d,"run",WalkType.getSpeedUser(4,MapManager3D.getInstance().isInsideArea()),4);
            }
            else if(walkType == 1)
            {
               Client.myTeam.modelGoTo(x3d,y3d,true,nextX3d,nextY3d,"walk",WalkType.getSpeedUser(1,MapManager3D.getInstance().isInsideArea()),4);
            }
            else
            {
               Client.myTeam.modelGoTo(x3d,y3d,true,nextX3d,nextY3d,"run",0,WalkType.getAnimSpeedMultiUser(walkType));
            }
         }
         var teamArr:Array = tab[1].split("&");
         var arrTeamUser:Array = teamArr[0].split("%");
         var arrTeamAi:Array = teamArr[1].split("%");
         var arrTeamQM:Array = teamArr[2].split("%");
         var arrChests:Array = teamArr[3].split("%");
         for(i = 0; i < arrTeamUser.length - 1; )
         {
            data = arrTeamUser[i];
            if(TextUtils.isEmpty(data))
            {
               traceWarning("MapManager3D.onMyTeamMovement() Empty TeamUser data");
            }
            else
            {
               t = new TeamUser(data);
               t = onNewTeamInSight(t,false,0,0,false,0,0,0,false);
               if(t.team3D == null)
               {
                  _initTeamModelsVec.push(t);
               }
            }
            i++;
         }
         for(j = 0; j < arrTeamAi.length - 1; )
         {
            data = arrTeamAi[j];
            if(TextUtils.isEmpty(data))
            {
               traceWarning("MapManager3D.onMyTeamMovement() Empty TeamMob data");
            }
            else
            {
               t = new TeamMob(data);
               t = onNewTeamInSight(t,false,0,0,false,0,0,0,false);
               if(t.team3D == null)
               {
                  _initTeamModelsVec.push(t);
               }
            }
            j++;
         }
         for(k = 0; k < arrTeamQM.length - 1; )
         {
            data = arrTeamQM[k];
            if(TextUtils.isEmpty(data))
            {
               traceWarning("MapManager3D.onMyTeamMovement() Empty TeamQM data");
            }
            else
            {
               t = new TeamQM(data);
               t = onNewTeamInSight(t,false,0,0,false,0,0,0,false);
               if(t.team3D == null)
               {
                  _initTeamModelsVec.push(t);
               }
            }
            k++;
         }
         for(l = 0; l < arrChests.length - 1; )
         {
            addChest(new Chest(arrChests[l]));
            l++;
         }
         if(_initTeamModelsVec.length > 0)
         {
            frameBasedInitTeamOnLiveMap();
         }
         removeInvisible();
         recalculateReducedViewDistance(false);
      }
      
