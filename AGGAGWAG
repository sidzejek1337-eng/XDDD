      public function onEnterNewArea(vo:AreaSetupVO) : void
      {
         TaernGlobals.fpsMeterBundle1secs.changedNoArgSignal.remove(onFPSDetection);
         if(!_mapPreloader)
         {
            _mapPreloader = _uiManager.showMapPreloader();
         }
         _areaVO = vo;
         createNewArea();
      }
      
      protected function createNewArea() : void
      {
         var aMapData:Array;
         var instData:Array;
         var groundData:GroundData;
         var shadowsData:String;
         var tempTeams:Array;
         var arrTeamUser:Array;
         var arrTeamAi:Array;
         var arrTeamQM:Array;
         var arrChests:Array;
         var preloadedModelArray:Array;
         var orthographicLens:OrthographicLens;
         var loadGround:GroundTile3D;
         var loadPlane:EnvironmentPlane3D;
         _startTimer = TimeUtils.getTimerANR();
         dbgTimeStart("map loading");
         dbgTimeStart("map onEnterNewArea");
         dbgTimeStart("map onEnterNewArea 1");
         if(DebugSettings.CLEAR_MEMORY_ON_ENTER_AREA)
         {
            Team3DObjectPool.getInstance().clearAllNotBusy();
            MemoryManager.getInstance().disposeAllUnused();
         }
         MAP_PRELOAD = true;
         OGSLManager.getInstance().parseShaders(_areaVO.shaderData || "");
         if(Settings.TEAMS_AI_GPU_PRELOAD)
         {
            if(_teamsMobGPUPreloader)
            {
               _teamsMobGPUPreloader.destroy();
               _teamsMobGPUPreloader = null;
            }
         }
         TeamAddService.instance.clear();
         MechanismAddService.instance.clear();
         EnviroAddService.instance.clear();
         _completeObserver = new CompleteObserver("MapManager");
         _completeObserver.addOnce(onLoadings_Ready);
         if(Settings.FRAME_BASE_PRELOAD)
         {
            if(_frameBaseLoadingObserver)
            {
               _frameBaseLoadingObserver.destroy();
            }
            _frameBaseLoadingObserver = new CompleteObserver("MapManager-frameBase");
            _frameBaseLoadingObserver.addOnce(onFrameBaseLoad_Ready);
         }
         aMapData = _areaVO.mapData.split(",");
         _areaId = parseInt(aMapData[0]);
         if(Settings.DEPTH_RENDERING && (_areaId == 264 || _areaId == 209))
         {
            Settings.HEIGHT_MAP = true;
         }
         else
         {
            Settings.HEIGHT_MAP = false;
         }
         dbgTimeStop("map onEnterNewArea 1");
         dbgTimeStart("map onEnterNewArea 2");
         _previousAreaData = _areaData;
         _areaData = new AreaData();
         _areaData.idArea = parseInt(aMapData[0]);
         _areaData.distanceVisible = Number(aMapData[1]);
         _distanceVisible = Number(aMapData[1]);
         _distanceVisibleReducedUsers = _distanceVisible;
         _distanceVisibleReducedNPC = _distanceVisible;
         _areaData.scale = Number(aMapData[5]);
         if(_areaData.scale == 1.5)
         {
            Settings.MAP_MODEL_SCALE = Settings.MAP_MODEL_SCALE_INSIDE;
         }
         else
         {
            Settings.MAP_MODEL_SCALE = Settings.MAP_MODEL_SCALE_OUTSIDE;
         }
         CameraManager.mapScale = _areaData.scale;
         Settings.MAP_CELL_SIZE = 1024 / CameraManager.mapScale;
         _areaData.marginTop = Number(aMapData[6]);
         _areaData.marginRight = Number(aMapData[7]);
         _areaData.marginBottom = Number(aMapData[8]);
         _areaData.marginLeft = Number(aMapData[9]);
         _areaData.isMask = aMapData[17] == "1";
         _areaData.maskScale = aMapData[15];
         _areaData.maskAlpha = aMapData[16];
         _areaData.marginTrigger = aMapData[10] == "1";
         _marginTop = _areaData.marginTop;
         _marginRight = _areaData.marginRight;
         _marginBottom = _areaData.marginBottom;
         _marginLeft = _areaData.marginLeft;
         _marginTrigger = _areaData.marginTrigger;
         instData = aMapData[11].split("|");
         _instanceIdUnique = int(instData[0]);
         if(_instanceIdUnique != -1)
         {
            _instanceName = instData[1];
            _instanceId = int(instData[2]);
            _instanceQuestBlock = int(instData[3]) == 1;
         }
         else
         {
            _instanceId = -1;
            _instanceName = "";
            _instanceQuestBlock = false;
         }
         _areaData.instanceName = _instanceName;
         _areaData.version = aMapData[12];
         FrameTime.onEnterArea("a" + _areaData.idArea + " i" + _instanceId);
         UserTracking.addAction(this,_areaData.idArea.toString(),"new map");
         groundData = new GroundData();
         groundData.idArea = parseInt(aMapData[0]);
         groundData.width = Number(aMapData[2]);
         groundData.height = Number(aMapData[3]);
         groundData.offsetX2D = Number(aMapData[13]);
         groundData.offsetY2D = Number(aMapData[14]);
         groundData.idGraphic = Number(aMapData[18]);
         if(!MathUtils.isNaNANR(Number(aMapData[19])))
         {
            areaData.cameraDX = Number(aMapData[19]);
         }
         if(!MathUtils.isNaNANR(Number(aMapData[20])))
         {
            areaData.cameraDZ = Number(aMapData[20]);
         }
         if(aMapData.length > 21 && !MathUtils.isNaNANR(Number(aMapData[21])))
         {
            areaData.layer = Number(aMapData[21]);
         }
         if(aMapData.length > 22 && !MathUtils.isNaNANR(Number(aMapData[22])))
         {
            areaData.lightMulti = Number(aMapData[22]);
         }
         if(aMapData.length > 23)
         {
            areaData.mappingDynamic = aMapData[23] == "1";
         }
         if(aMapData.length > 24)
         {
            areaData.blockPets = aMapData[24] == "1";
         }
         if(aMapData[4] == "")
         {
            groundData.skyUrl = Path.forTag("<sky_texture>","sky_negX2s");
         }
         else
         {
            groundData.skyUrl = Path.forTag("<sky_texture>",aMapData[4]);
         }
         if(!_movementManager)
         {
            _movementManager = MovementManager.getInstance();
         }
         _movementManager.initMapping(_areaId,_instanceIdUnique,areaData.mappingDynamic);
         addObjectToLoad(_movementManager.mapping,"mapping");
         shadowsData = "";
         tempTeams = _areaVO.teamsData.split("&");
         arrTeamUser = tempTeams[0].split("%");
         arrTeamAi = tempTeams[1].split("%");
         arrTeamQM = tempTeams[2].split("%");
         arrChests = tempTeams[3].split("%");
         if(!Settings.TEAM_MODELS_OFF && Settings.TEAMS_AI_GPU_PRELOAD)
         {
            preloadedModelArray = _areaVO.preloadModelsData.split("%");
         }
         orthographicLens = TaernCore.instance.away.orthographicLens;
         if(Settings.CAMERA_HACK_GPU_PRELOAD)
         {
            _savedProjectionHeight = orthographicLens.projectionHeight;
            _savedFar = orthographicLens.far;
            orthographicLens.projectionHeight = 5000;
            orthographicLens.far = 5000;
         }
         dbgTimeStop("map onEnterNewArea 2");
         if(!_mapView3D.initialized)
         {
            dbgTimeStart("map onEnterNewArea 4.1 map view");
            Dbg.traceTimeD("MapManager3d: _mapView3D.initialized");
            _mapView3D.createMapView(_areaId,groundData,_areaVO.lightsData,shadowsData,_areaVO.planeSheetsData,_areaVO.cloudData,"",_areaVO.forceLight);
            dbgTimeStop("map onEnterNewArea 4.1 map view");
            for each(loadGround in _mapView3D.groundView.groundObjects)
            {
               addObjectToLoad(loadGround,"GroundTile3D " + loadGround.column + "," + loadGround.row);
            }
            for each(loadPlane in _mapView3D.planeSheetView.mergeVector)
            {
               addObjectToLoad(loadPlane,"PlaneSheet id:" + loadPlane.data.id);
            }
         }
         PlaneSheetModel.getInstance().initMap(_mapView3D.planeSheetView);
         MechanismManager.getInstance().mechVector = _mapView3D.mechVector;
         addMechanismsOnEnterAreaFrames(_areaVO.mechanismData);
         dbgTimeStart("map onEnterNewArea 6");
         addTeamsOnEnter(arrTeamUser,arrTeamAi,arrTeamQM,preloadedModelArray,arrChests);
         dbgTimeStop("map onEnterNewArea 6.1");
         dbgTimeStop("map onEnterNewArea 6");
         dbgTimeStart("map onEnterNewArea 7");
         if(Settings.SOUND)
         {
            addObjectToLoad(TaernSoundEngine.instance,"sounds");
            TaernSoundEngine.instance.soundPreloadedSignal.addOnce(function():void
            {
               markObjectAsLoaded(TaernSoundEngine.instance,"sounds");
            });
            TaernSoundEngine.instance.loadTemplates(_areaVO.soundsData);
            TaernSoundEngine.instance.onMove(false);
            myTeamMovedSignal.add(TaernSoundEngine.instance.onMove);
         }
         UIManager.hideDungeonMaskVote.setVote(this,!_areaData.isMask);
         _uiManager.dungeonMask.setDefaultProperties(_areaData.maskScale,_areaData.maskAlpha);
         if(_areaData.isMask)
         {
            _uiManager.hideFocusMask();
         }
         else
         {
            _uiManager.showFocusMask();
         }
         dbgTimeStop("map onEnterNewArea 7");
         dbgLogVal("area id",_areaData.idArea);
         dbgTimeStop("map onEnterNewArea");
      }
      
      protected function onFrameBaseLoad_Ready() : void
      {
         calculateReducedViewDistance();
         calculateReducedViewDistanceNPC();
         hideTeamsOutOfReducedRange(false);
         onFrameBasedLoadReady.dispatch();
      }
      
      private function addTeamsOnEnter(arrTeamUser:Array, arrTeamAi:Array, arrTeamQM:Array, preloadedModelArray:Array, arrChests:Array) : void
      {
         if(Settings.FRAME_BASE_PRELOAD)
         {
            _completeObserver.addProcess(TeamAddService.instance,"addTeamsOnEnter",TeamAddService.instance.readySignal);
            _frameBaseLoadingObserver.addProcess(TeamAddService.instance,"_frameBaseLoadingObserver.addTeamsOnEnter",TeamAddService.instance.readySignal);
            TeamAddService.instance.load(arrTeamUser,arrTeamAi,arrTeamQM,preloadedModelArray,arrChests);
            return;
         }
      }
      
      private function onLoadings_Ready() : void
      {
         var orthographicLens:OrthographicLens = null;
         dbgTimeStop("map loading");
         dbgTimeStart("map onLoadings_Ready");
         if(_mapView3D.lightsView)
         {
            Team3DObjectPool.getInstance().reloadLightsInPool(_mapView3D.lightsView.lightPicker);
            Team3DObjectPool.getInstance().reloadShadowsInPool(_mapView3D.lightsView.simpleShadowMapMethodBase);
         }
         _completeObserver.destroy();
         _completeObserver = null;
         customsOnMapReady();
         _mapView3D.visible = true;
         if(_teamsMobGPUPreloader)
         {
            _teamsMobGPUPreloader.destroy();
            _teamsMobGPUPreloader = null;
         }
         MAP_PRELOAD = false;
         if(Settings.CAMERA_HACK_GPU_PRELOAD)
         {
            orthographicLens = TaernCore.instance.away.orthographicLens;
            orthographicLens.projectionHeight = _savedProjectionHeight;
            orthographicLens.far = _savedFar;
         }
         dbgTimeStop("map onLoadings_Ready");
         dbgTimeStart("map postMapViewReady");
         EnterFrameSignal.signal.addOnce(postMapViewReady,"MapManager3D.postMapViewReady");
         TaernGlobals.fpsMeterBundle1secs.changedNoArgSignal.add(onFPSDetection);
      }
      
      public function revertMask() : void
