      {
         var oldTeam:Team = getTeamById(team.id);
         if(oldTeam)
         {
            if(_completeObserver)
            {
               _completeObserver.markAsCompleted(team);
            }
            team.destroy();
            team = oldTeam;
            team.removeCancel();
            if(onEnterNewArea)
            {
               Dbg.criticalError("2  teams with same id - shouldn\'t happen! Please inform drygu :)");
            }
         }
         else
         {
            if(initTeamView)
            {
               team.initTeamView();
            }
            addTeam(team);
            particleEmmiterForObjectRefresh();
         }
         var anim:String = WalkType.getAnim(animType);
         if(newX3d != 0 || newY3d != 0)
         {
            if(newX3d != team.x || newY3d != team.y)
            {
               team.modelGoTo(newX3d,newY3d,mapMove,0,0,anim,speed,animSpeedMulti);
            }
         }
         hideIfReducedView(team);
         teamMoved(team);
         return team;
      }
      
