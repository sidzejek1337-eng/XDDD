      public function initGameplay() : void
      {
         _movementManager = MovementManager.getInstance();
         _cameraPositionManager = new MapCameraPositionManager(TaernCore.instance.away.cameraMap,this);
         CameraManager.getInstance().initCameraPositionManager(_cameraPositionManager);
         _cameraContainer = new CameraContainer(_cameraPositionManager);
         _rain = new MapRainsManager(RainSetupVO.createNormalSetups(),_cameraContainer);
         _uiManager = UIManager.getInstance();
         TaernGlobals.fpsMeterBundle1secs.changedNoArgSignal.add(onFPSDetection);
      }
      
      public function destroyGamplay() : void
      {
         _rain.destroy();
         _rain = null;
         _cameraPositionManager.destroy();
         _cameraPositionManager = null;
         _cameraContainer.destroy();
         _cameraContainer = null;
         myTeamMovedSignal.remove(TaernSoundEngine.instance.onMove);
      }
      
      public function initMap(areaId:int, view:View3D) : MapInteractionsManager
      {
         _areaId = areaId;
         _view3D = view;
         if(_mapView3D)
         {
            traceWarning("should be destroyed already",true);
         }
         _cameraPositionManager.newArea = true;
         _mapView3D = MapViewFactory.getMapView(areaId);
         _view3D.scene.addChild(_mapView3D);
         if(!_mapView3D.initialized)
         {
            _mapView3D.initContent();
            _mapView3D.addChild(_cameraContainer);
            _mapView3D.addEventListener("click3d",onMapClick);
            _mapView3D.mouse3DPosition.changedSignal.add(refreshMousePositions);
         }
         else if(_mapView3D.checkInit())
         {
            _mapView3D.reInitContent();
         }
         else
         {
            _mapView3D.initContent();
            _mapView3D.addChild(_cameraContainer);
            _mapView3D.addEventListener("click3d",onMapClick);
            _mapView3D.mouse3DPosition.changedSignal.add(refreshMousePositions);
         }
         _interactions = _mapView3D.interactions;
         refreshMousePositions();
         return _interactions;
      }
      
      private function refreshMousePositions() : void
      {
         if(_mapView3D == null)
         {
            return;
         }
         mouseTilesPosition.setXY(_mapView3D.mouseTilePosition.x,_mapView3D.mouseTilePosition.y);
         mouse3DPosition.setXY(_mapView3D.mouse3DPosition.x,_mapView3D.mouse3DPosition.y);
      }
      
      private function onMapClick(event:MouseEvent3D) : void
      {
         mapClickedSignal.dispatch();
      }
      
      private function onFPSDetection() : void
      {
         if(!GameState.isFight.value)
         {
            _fpsManager.checkFpsMap(Math.round(TaernGlobals.fpsMeterBundle1secs.value));
         }
      }
      
