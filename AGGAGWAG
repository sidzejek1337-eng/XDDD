                  _distanceVisibleReducedNPC -= 1;
               }
               if(_distanceVisibleReducedNPC < MIN_DISTANCE_VISIBLE_NPC)
               {
                  _distanceVisibleReducedNPC = MIN_DISTANCE_VISIBLE_NPC;
               }
               else
               {
                  calculateReducedViewDistanceNPC(++loopCount);
               }
            }
         }
         else
         {
            _distanceVisibleReducedNPC = _distanceVisible;
         }
      }
      
      private function recalculateReducedViewDistance(force:Boolean = false) : void
      {
         var count:int = 0;
         var countNPC:int = 0;
         var reHide:Boolean = false;
         if(_teams.length <= MAX_TEAMS_USER_VISIBLE && _teams.length <= MAX_TEAMS_NPC_VISIBLE)
         {
            return;
         }
         var countUTeams:int = countUserTeams();
         var countNTeams:int = countNpcTeams();
         if(countUTeams - 1 > MAX_TEAMS_USER_VISIBLE || countNTeams > MAX_TEAMS_NPC_VISIBLE)
         {
            if(!(force || countUTeams - 1 > MAX_TEAMS_USER_VISIBLE * 1.2 || TimeUtils.getTimerANR() - _lastTimeRecalculatedDistance > 500))
            {
               return;
            }
            _lastTimeRecalculatedDistance = TimeUtils.getTimerANR();
            count = countPlayersInReducedRange();
            countNPC = countNPCInReducedRange();
            if(count > 1.2 * MAX_TEAMS_USER_VISIBLE)
            {
               calculateReducedViewDistance();
               hideTeamsOutOfReducedRange(false);
               return;
            }
            if(count > MAX_TEAMS_USER_VISIBLE || countNPC > MAX_TEAMS_NPC_VISIBLE)
            {
               if(count > MAX_TEAMS_USER_VISIBLE)
               {
                  _distanceVisibleReducedUsers -= 1;
                  if(_distanceVisibleReducedUsers < MIN_DISTANCE_VISIBLE_USERS)
                  {
                     _distanceVisibleReducedUsers = MIN_DISTANCE_VISIBLE_USERS;
                  }
               }
               if(countNPC > MAX_TEAMS_NPC_VISIBLE)
               {
                  _distanceVisibleReducedNPC -= 1;
                  if(_distanceVisibleReducedNPC < MIN_DISTANCE_VISIBLE_NPC)
                  {
                     _distanceVisibleReducedNPC = MIN_DISTANCE_VISIBLE_NPC;
                  }
               }
               hideTeamsOutOfReducedRange(true);
            }
            else
            {
               reHide = false;
               if(_distanceVisibleReducedUsers < _distanceVisible)
               {
                  if(count < MAX_TEAMS_USER_VISIBLE * 0.8)
                  {
                     ++_distanceVisibleReducedUsers;
                     count = countPlayersInReducedRange();
                     if(count > MAX_TEAMS_USER_VISIBLE)
                     {
                        --_distanceVisibleReducedUsers;
                     }
                     else
                     {
                        reHide = true;
                     }
                  }
               }
               if(countNPC < MAX_TEAMS_NPC_VISIBLE * 0.8)
               {
                  ++_distanceVisibleReducedNPC;
                  countNPC = countNPCInReducedRange();
                  if(countNPC > MAX_TEAMS_NPC_VISIBLE)
                  {
                     --_distanceVisibleReducedNPC;
                  }
                  else
                  {
                     reHide = true;
                  }
               }
               if(reHide)
               {
                  hideTeamsOutOfReducedRange(true);
               }
            }
         }
         else if(_distanceVisibleReducedUsers != _distanceVisible || _distanceVisibleReducedNPC != _distanceVisible)
         {
            _distanceVisibleReducedUsers = _distanceVisible;
            _distanceVisibleReducedNPC = _distanceVisible;
            for each(var team:Team in _teams)
            {
               unHideTeam(team);
            }
         }
      }
      
      private function countPlayersInReducedRange() : int
      {
         var count:int = 0;
         for each(var team:Team in _teams)
         {
            if(team != Client.myTeam && team.isUser())
            {
               if(isInRange(CoordinatesHelper.from3DToTile2D_X(team.x),CoordinatesHelper.from3DToTile2D_Y(team.y),_distanceVisibleReducedUsers))
               {
                  count++;
               }
            }
         }
         return count;
      }
      
      private function countNPCInReducedRange() : int
      {
         var count:int = 0;
         for each(var team:Team in _teams)
         {
            if(!team.isUser())
            {
               if(isInRange(CoordinatesHelper.from3DToTile2D_X(team.x),CoordinatesHelper.from3DToTile2D_Y(team.y),_distanceVisibleReducedNPC))
               {
                  count++;
               }
            }
         }
         return count;
      }
      
