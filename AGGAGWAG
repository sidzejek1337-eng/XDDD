      {
         var anim:String = WalkType.getAnim(animType);
         var team:Team = getTeamById(id);
         if(team != null)
         {
            if(team == Client.myTeam && _leader)
            {
               _movementManager.onServerUpdate(CoordinatesHelper.from3DToTile2D_X(x),CoordinatesHelper.from3DToTile2D_Y(y));
               removeInvisible();
            }
            else
            {
               if(team is TeamUser)
               {
                  if(TeamUser(team).lookOverride != null)
                  {
                     animSpeedMulti = 4;
                  }
                  else
                  {
                     animSpeedMulti = WalkType.getAnimSpeedMultiUser(animType);
                  }
               }
               if(x3d != 0 && y3d != 0)
               {
                  team.modelGoTo(x3d,y3d,false,nextX3d,nextY3d,anim,speed,animSpeedMulti);
               }
               else
               {
                  team.modelGoTo(x,y,false,nextX3d,nextY3d,anim,speed,animSpeedMulti);
               }
               if(!isVisible(CoordinatesHelper.from3DToTile2D_X(x),CoordinatesHelper.from3DToTile2D_Y(y)))
               {
                  team.removeWithTween();
                  recalculateReducedViewDistance();
               }
               else if(team.isUser())
               {
                  if(_distanceVisibleReducedUsers < _distanceVisible)
                  {
                     if(!isInRange(CoordinatesHelper.from3DToTile2D_X(x),CoordinatesHelper.from3DToTile2D_Y(y),_distanceVisibleReducedUsers))
                     {
                        hideTeam(team,true);
                     }
                     else
                     {
                        unHideTeam(team,true);
                     }
                  }
               }
               else if(!isInRange(CoordinatesHelper.from3DToTile2D_X(x),CoordinatesHelper.from3DToTile2D_Y(y),_distanceVisibleReducedNPC))
               {
                  hideTeam(team,true);
               }
               else
               {
                  unHideTeam(team,true);
               }
            }
         }
      }
      
