      public function findTeam(id:String) : Team
      {
         var i:int = 0;
         var team:TeamQM = null;
         if(id == "user")
         {
            return Client.myTeam;
         }
         i = 0;
         while(i < _teams.length)
         {
            if(_teams[i] is TeamQM)
            {
               team = TeamQM(_teams[i]);
               if(team.id.split("_")[1] == id)
               {
                  return team;
               }
            }
            i++;
         }
         return null;
      }
      
