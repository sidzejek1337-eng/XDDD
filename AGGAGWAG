            FrameTime.stopTimer("teamMove.particleEmmiters");
         }
         if(t == Client.myTeam)
         {
            FrameTime.startTimer("teamMove.myTeamMovedSignal");
            myTeamMovedSignal.dispatch();
            FrameTime.stopTimer("teamMove.myTeamMovedSignal");
         }
      }
      
      public function teamDestroyed(t:Team) : void
      {
         var i:int = 0;
         var emitter:ParticleEmitter = null;
         if(t.team3D == null || _particleEmitters == null || _particleEmitters.length == 0)
         {
            return;
         }
         FrameTime.startTimer("teamDestroyed.particleEmmiters");
         for(i = 0; i < _particleEmitters.length; )
         {
            emitter = _particleEmitters[i];
            emitter.onTeamDestroy(t);
            i++;
         }
         FrameTime.stopTimer("teamDestroyed.particleEmmiters");
      }
      
